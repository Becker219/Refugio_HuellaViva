<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="reporte_inventario" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="TITULO_INSTITUCION" class="java.lang.String"/>

    <queryString>
        <![CDATA[
        SELECT 
            CAST(i.id_insumo AS CHAR) AS idInsumo,
            i.descripcion AS descripcion,
            c.nombre AS categoria,
            CAST(i.stock_actual AS CHAR) AS stockActual,
            CAST(i.stock_minimo AS CHAR) AS stockMinimo,
            CONCAT('S/ ', FORMAT(i.costo_unitario, 2)) AS costoUnitario,
            CONCAT('S/ ', FORMAT(i.stock_actual * i.costo_unitario, 2)) AS valorTotal,
            DATE_FORMAT(i.fecha_vencimiento, '%d/%m/%Y') AS fechaVencimiento,
            CASE WHEN i.stock_actual <= i.stock_minimo THEN 'REABASTECER' ELSE 'NORMAL' END AS estadoStock
        FROM tb_insumo i
        INNER JOIN tb_categoria_insumo c ON i.id_categoria = c.id_categoria
        ORDER BY c.nombre ASC, i.descripcion ASC
        ]]>
    </queryString>

    <field name="idInsumo" class="java.lang.String"/>
    <field name="descripcion" class="java.lang.String"/>
    <field name="categoria" class="java.lang.String"/>
    <field name="stockActual" class="java.lang.String"/>
    <field name="stockMinimo" class="java.lang.String"/>
    <field name="costoUnitario" class="java.lang.String"/>
    <field name="valorTotal" class="java.lang.String"/>
    <field name="fechaVencimiento" class="java.lang.String"/>
    <field name="estadoStock" class="java.lang.String"/>

    <title>
        <band height="75">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="65" backcolor="#0D6EFD"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="15" y="10" width="525" height="25" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="15" isBold="true"/>
                </textElement>
                <text><![CDATA[REPORTE VALORIZADO DE INSUMOS MÉDICOS Y ALIMENTO]]></text>
            </staticText>
            <textField>
                <reportElement x="15" y="36" width="525" height="20" forecolor="#CFE2FF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TITULO_INSTITUCION}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="28">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="25" backcolor="#CFE2FF"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#9EC5FE"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="4" y="0" width="146" height="25"/>
                <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[INSUMO / DESCRIPCIÓN]]></text>
            </staticText>
            <staticText>
                <reportElement x="166" y="0" width="94" height="25"/>
                <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[CATEGORÍA]]></text>
            </staticText>
            <staticText>
                <reportElement x="262" y="0" width="46" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[STOCK]]></text>
            </staticText>
            <staticText>
                <reportElement x="310" y="0" width="52" height="25"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[COSTO U.]]></text>
            </staticText>
            <staticText>
                <reportElement x="364" y="0" width="60" height="25"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[VALORIZADO]]></text>
            </staticText>
            <staticText>
                <reportElement x="426" y="0" width="56" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[VENCE]]></text>
            </staticText>
            <staticText>
                <reportElement x="484" y="0" width="68" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[ALERTA]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="28">
            <line>
                <reportElement positionType="FixRelativeToBottom" x="0" y="27" width="555" height="1" forecolor="#E0E0E0"/>
            </line>
            <textField textAdjust="StretchHeight">
                <reportElement x="4" y="4" width="146" height="18"/>
                <textElement verticalAlignment="Top"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="166" y="4" width="94" height="18"/>
                <textElement verticalAlignment="Top"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{categoria}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="262" y="4" width="46" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Top"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{stockActual} + " / " + $F{stockMinimo}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="310" y="4" width="52" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Top"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{costoUnitario}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="364" y="4" width="60" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Top"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{valorTotal}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="426" y="4" width="56" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Top"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{fechaVencimiento}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="484" y="4" width="68" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Top"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{estadoStock}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="0" y="10" width="555" height="15" forecolor="#6C757D"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " - Generado por Refugio Huella Viva"]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>